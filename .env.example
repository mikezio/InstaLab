# Core
INSTALAB_ENV=/app/.env
INSTALAB_DB_TYPE=postgres
INSTALAB_DB_HOST=
INSTALAB_DB_PORT=
INSTALAB_DB_NAME=
INSTALAB_DB_USER=
INSTALAB_DB_PASS=
INSTALAB_API_BASE=http://127.0.0.1:5000/
INSTALAB_UI_BASE_URL=
INSTALAB_UI_PORT=8000
INSTALAB_UI_VARIANT=legacy
INSTALAB_LOGINS_FILE=/data/instalab/instalab-logins.json
INSTALAB_COOKIE_DIR=/data/instalab/cookies
INSTALAB_SCRAPER_BACKEND=browser
INSTALAB_BROWSER_STORAGE_PATH=/app/.playwright/instagram_storage.json
INSTALAB_BLOCKED_LOGINS=
INSTALAB_PROXY_ENABLED=false
INSTALAB_PROXY_PROVIDER=decodo
INSTALAB_PROXY_HOST=gate.decodo.com
INSTALAB_PROXY_PORT=7000
INSTALAB_PROXY_USERNAME=
INSTALAB_PROXY_PASSWORD=
INSTALAB_ENCRYPTION_KEY=

# Django settings (IMPORTANT: Set these in production!)
# Generate a secure secret key with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Defaults / tuning
UI_TIMEZONE=America/New_York
RUN_STALL_SECONDS=1200
RUN_MAX_SECONDS=10800
RUN_REQUEST_TIMEOUT=600
RUN_ITEM_DELAY_MIN=0.25
RUN_ITEM_DELAY_MAX=0.75
MONITOR_INTERVAL_MINUTES=120
MONITOR_THRESHOLD_DELTA=4
MONITOR_MIN_GAP_MINUTES=180
MONITOR_LOGIN_USERNAME=
RECON_ENABLED=true
RECON_MAX_CONCURRENCY=2
RECON_TIMEOUT_SECONDS=240
RECON_BLACKBIRD_AI_ENABLED=false
RECON_BLACKBIRD_NO_NSFW=true
RECON_BLACKBIRD_CMD=python /app/scripts/blackbird_proxy.py
RECON_BLACKBIRD_RESULTS_DIR=/tmp/instalab-blackbird/results
RECON_PHONEINFOGA_ENABLED=true
RECON_PHONEINFOGA_CMD=/usr/local/bin/phoneinfoga

# WhatsApp Cloud API integration (optional)
INSTALAB_WHATSAPP_ENABLED=false
INSTALAB_WHATSAPP_COMMAND_ENABLED=true
INSTALAB_WHATSAPP_NOTIFY_ENABLED=true
INSTALAB_WHATSAPP_VERIFY_TOKEN=
INSTALAB_WHATSAPP_ACCESS_TOKEN=
INSTALAB_WHATSAPP_PHONE_NUMBER_ID=
INSTALAB_WHATSAPP_API_VERSION=v22.0
INSTALAB_WHATSAPP_ALLOWLIST=
INSTALAB_WHATSAPP_NOTIFY_TO=

# 2FA (optional)
INSTALAB_2FA_CODE=
RUN_2FA_CODE=

# Datadog (optional)
DD_SERVICE=
DD_ENV=
DD_VERSION=
DD_TRACE_ENABLED=true
DD_LOGS_INJECTION=true
DD_RUNTIME_METRICS_ENABLED=true
DD_AGENT_HOST=
DD_TRACE_AGENT_PORT=

# Core
INSTALAB_ENV=/app/.env
INSTALAB_DB_TYPE=sqlite
INSTALAB_DB_HOST=
INSTALAB_DB_PORT=
INSTALAB_DB_NAME=
INSTALAB_DB_USER=
INSTALAB_DB_PASS=
INSTALAB_SQLITE_PATH=/data/instalab/instaloader.db
INSTALAB_API_BASE=http://127.0.0.1:5000/
INSTALAB_LOGINS_FILE=/data/instalab/instalab-logins.json
INSTALAB_COOKIE_DIR=/data/instalab/cookies
INSTALAB_SCRAPER_BACKEND=instaloader
INSTALAB_BLOCKED_LOGINS=

# Defaults / tuning
UI_TIMEZONE=America/New_York
RUN_STALL_SECONDS=1200
RUN_MAX_SECONDS=10800
RUN_REQUEST_TIMEOUT=600
RUN_ITEM_DELAY_MIN=0.25
RUN_ITEM_DELAY_MAX=0.75
MONITOR_INTERVAL_MINUTES=120
MONITOR_THRESHOLD_DELTA=4
MONITOR_MIN_GAP_MINUTES=180
MONITOR_LOGIN_USERNAME=

# Login profiles (optional base accounts)
MZIO_LOGIN_USERNAME=
MZIO_LOGIN_PASSWORD=
MZIO_COOKIE_FILE=
MZIO_DB_PATH=
DJ_LOGIN_USERNAME=
DJ_LOGIN_PASSWORD=
DJ_COOKIE_FILE=
DJ_DB_PATH=

# Selenium / browser automation
SELENIUM_HEADLESS=1
CHROME_BIN=/usr/bin/chromium
CHROMEDRIVER_BIN=/usr/bin/chromedriver
SELENIUM_HOME=/tmp/instalab-chrome
XDG_RUNTIME_DIR=/tmp/xdg-runtime

# 2FA (optional)
INSTALAB_2FA_CODE=
RUN_2FA_CODE=

# Django settings
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Datadog (optional)
DD_SERVICE=
DD_ENV=
DD_VERSION=
DD_TRACE_ENABLED=true
DD_LOGS_INJECTION=true
DD_RUNTIME_METRICS_ENABLED=true
DD_AGENT_HOST=
DD_TRACE_AGENT_PORT=
